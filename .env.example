# Agente de escucha: plantilla de variables de entorno
# Copia a .env y llena los valores reales. Nunca subas .env (está en .gitignore).
# Todo valor aquí está vacío o es un ejemplo. Entre corchetes, lo que usa el código si la variable no existe.
# Mismos nombres que el tablero LATAM Growth (#286) donde aplica.

# ─── Inyectadas por el runtime: NO las pongas en .env del servicio ──────────────
# PORT=            puerto HTTP (asignado automáticamente)
# DATABASE_URL=    mysql://user:pass@host:port/db   (o DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME)
# BASE_PATH=       prefijo público de la URL
# En tu máquina: PORT=3000 para `npm start`; sin DATABASE_URL solo funciona `npm run scan:dry`.

# ─── Acceso ────────────────────────────────────────────────────────────────
# SIN LOGIN por ahora (fase de QA): no hay variables de acceso. Todo queda a nombre de qa@think4ever.com.
# El login con Microsoft vuelve cuando el equipo entregue la app de OAuth (ver lib/auth.js).

# ─── Claude (clasificar y redactar) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
# Solo modelos Claude (empiezan por claude-); otro nombre detiene la redacción [claude-opus-5-5]
# Las llamadas van siempre a https://api.anthropic.com: ANTHROPIC_BASE_URL se ignora.
ANTHROPIC_MODEL=
# low | medium | high [medium]
LLM_EFFORT=
# Máximo de hilos que pasan a Claude por corrida; controla el costo diario [40]
MAX_LLM_PER_RUN=
# Puntaje mínimo (0-100) para entrar a la cola [50]
MIN_RELEVANCE=

# ─── Fuentes ─────────────────────────────────────────────────────────────────
# Reddit: app tipo "script" de la cuenta de la marca, solo lectura. Requiere aprobación de Reddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=think4ever-listening/0.1 (by u/IMT4E)
# GitHub: token fine-grained, "Public repositories (read-only)", con vencimiento
GITHUB_TOKEN=
# Hacker News (API de Algolia) no necesita credenciales.

# ─── Corrida diaria ──────────────────────────────────────────────────────────
# 0 = solo corridas manuales [1]
SCAN_ENABLED=
# Hora de Bogotá, 0-23 [6]
SCAN_HOUR=
# Ventana de búsqueda en horas [36]
LOOKBACK_HOURS=

# ─── Enlaces y UTM ───────────────────────────────────────────────────────────
# Reddit arranca 2 a 3 semanas sin enlaces (decisión 2026-10-16). 1 = enlaces activos [0]
LINKS_ENABLED=
# [https://go.think4ever.com/developer-network-co]
LINK_DESTINATION=
# [developer_network_co_202611]
UTM_CAMPAIGN=

# ─── Cola ────────────────────────────────────────────────────────────────────
# Publicaciones por persona y por día [8]
MAX_POSTS_PER_PERSON_PER_DAY=
# Quien editó por última vez el borrador no puede aprobarlo [0 mientras no haya login; 1 cuando vuelva]
REQUIRE_DISTINCT_APPROVER=

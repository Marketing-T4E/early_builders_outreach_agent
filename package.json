{
  "name": "early-builders-outreach-agent",
  "version": "0.1.0",
  "description": "Agente de escucha de Think4Ever: encuentra hilos en Reddit, Hacker News y GitHub Discussions, redacta la respuesta y la deja en cola. Publica una persona.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "prestart": "npm install --no-audit --no-fund",
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "scan": "node scripts/scan.js",
    "scan:dry": "node scripts/scan.js --dry-run",
    "report": "node scripts/report.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.24.6"
  },
  "engines": {
    "node": ">=20"
  }
}
